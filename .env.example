# Local development uses SQLite by default. These are optional:
# ROOK_DATA_DIR=./data
# KEYNEST_DATA_DIR=./data

# Production on Vercel with Supabase PostgreSQL.
# Use the transaction-pooler connection string from Supabase Dashboard -> Connect.
# ROOK_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require
# ROOK_DATABASE_SSL=true
# ROOK_DATABASE_SSL_REJECT_UNAUTHORIZED=true
# The pooler certificate is signed by Supabase Root 2021 CA, which is not in the public trust store.
# If this file is missing at runtime, the server uses the copy bundled in src/server/supabase-ca.ts.
# ROOK_DATABASE_SSL_CA=certs/supabase-root-2021.crt
# ROOK_DATABASE_POOL_MAX=3
# ROOK_DATABASE_CONNECT_TIMEOUT_MS=15000

# WebAuthn. Required on any public host. Localhost can derive them from the request.
# Set both to the final origin before anyone registers a passkey.
# ROOK_WEBAUTHN_ORIGIN=https://your-project.vercel.app
# ROOK_WEBAUTHN_RP_ID=your-project.vercel.app

# Public deploys accept one new vault, then close registration.
# Set true to keep sign-up open, or false to close it immediately.
# ROOK_ALLOW_REGISTRATION=false

# Optional. Hides whether a username exists. When unset, the server stores its own.
# ROOK_KDF_PEPPER=

# Only for throwaway Vercel previews with no database. Never use for a real vault.
# ROOK_ALLOW_EPHEMERAL_SQLITE=true

# Vercel sets VERCEL=1 automatically. Do not set it locally.
